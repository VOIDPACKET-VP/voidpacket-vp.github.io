---
title: Notes
permalink: /notes/index.html
---
{% extends "layouts/scroll-page.njk" %}

{% block heroContent %}
  <div class="hero-tag">Cheatsheets &amp; Methodology</div>
  <h1 class="hero-name">Field <span>Notes</span></h1>
  <p class="hero-role">Tool cheatsheets, methodology, and tech deep-dives.</p>
{% endblock %}

{% block content %}
  <div class="section">
    <div class="section-label reveal">{{ collections.notes.length }} Total</div>
    <h2 class="section-title reveal">All notes.</h2>

    {% set categories = collections.notes | uniqueValues("category") %}
    <div class="filter-bar reveal">
      <button class="filter-btn active" data-filter="all">All</button>
      {% for cat in categories %}
      <button class="filter-btn" data-filter="{{ cat }}">{{ cat }}</button>
      {% endfor %}
    </div>

    {% if collections.notes.length %}
    <div class="entry-list reveal-stagger">
      {% for item in collections.notes %}
      <a href="{{ item.url }}" class="entry-row" data-tags="{{ item.data.category }}">
        <span class="entry-cat">{{ item.data.category }}</span>
        <div class="entry-body">
          <div class="entry-title">{{ item.data.title }}</div>
          <div class="entry-summary">{{ item.data.summary }}</div>
          {% if item.data.tags %}
          <div class="entry-tags">
            {% for tag in item.data.tags %}<span class="entry-tag">{{ tag }}</span>{% endfor %}
          </div>
          {% endif %}
        </div>
        <div class="entry-meta">
          <span class="entry-date">{{ item.data.date | dateReadable }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state reveal">No notes yet — push a markdown file to <code>src/content/notes/</code> to get started.</div>
    {% endif %}
  </div>
{% endblock %}
