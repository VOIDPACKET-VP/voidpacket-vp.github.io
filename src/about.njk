{% extends "layouts/scroll-page.njk" %}

{% block heroContent %}
  <div class="hero-tag">About me</div>
  <h1 class="hero-name">Akram<br><span>ELQABLY</span></h1>
  <p class="hero-role">Web & Game Dev &nbsp;·&nbsp; Cybersecurity &nbsp;·&nbsp; Build to Break</p>
{% endblock %}

{% block content %}

  <!-- ── Background & Hobbies ── -->
  <div class="section">
    <div class="section-label reveal">Background &amp; Interests</div>
    <h2 class="section-title reveal">Who I am.</h2>

    <div class="bio-grid">
      <div class="bio-text reveal">
        <p>Hi, I'm Akram. I was born in Azilal, a small town in the Atlas Mountains of Morocco. Now, I'm navigating the space between web development, game dev, design, and cybersecurity.</p>
        <p>I'm still figuring out exactly where I belong in this field, but I'm in no rush. I believe it's a marathon, not a sprint. Right now, I'm just focused on building things I like and seeing where they take me.</p>
        <p>I believe great software is invisible. It just works, feels natural, and leaves you wanting more.</p>
      </div>

      <div class="hobbies-grid reveal-stagger">
        <div class="hobby-card">
          <span class="hobby-icon">🎮</span>
          <div class="hobby-title">Gaming</div>
          <div class="hobby-desc">Mostly singleplayer. Currently obsessed with immersive story games.</div>
        </div>
        <div class="hobby-card">
          <span class="hobby-icon">🎨</span>
          <div class="hobby-title">Design</div>
          <div class="hobby-desc">UI exploration, motion design, and obsessing over kerning.</div>
        </div>
        <div class="hobby-card">
          <span class="hobby-icon">🚴‍♂️</span>
          <div class="hobby-title">Cycling</div>
          <div class="hobby-desc">Nothing makes me feel more alive than me, my bike and nature.</div>
        </div>
        <div class="hobby-card">
          <span class="hobby-icon">🛠️</span>
          <div class="hobby-title">Building</div>
          <div class="hobby-desc">Side projects, tools, experiments — if an idea sticks, I build it.</div>
        </div>
      </div>
    </div>

    <!-- What I love marquee -->
    <div class="love-strip reveal">
      <div class="love-track" id="loveTrack">
        <span class="love-item accent">Clean Code</span>
        <span class="love-item">·</span>
        <span class="love-item">Minimalism</span>
        <span class="love-item">·</span>
        <span class="love-item accent">Good Typography</span>
        <span class="love-item">·</span>
        <span class="love-item">Open Source</span>
        <span class="love-item">·</span>
        <span class="love-item accent">Dark Themes</span>
        <span class="love-item">·</span>
        <span class="love-item">Smooth Animations</span>
        <span class="love-item">·</span>
        <span class="love-item accent">Tea</span>
        <span class="love-item">·</span>
        <span class="love-item">Fast Builds</span>
        <span class="love-item">·</span>
        <!-- duplicate for seamless loop -->
        <span class="love-item accent">Clean Code</span>
        <span class="love-item">·</span>
        <span class="love-item">Minimalism</span>
        <span class="love-item">·</span>
        <span class="love-item accent">Good Typography</span>
        <span class="love-item">·</span>
        <span class="love-item">Open Source</span>
        <span class="love-item">·</span>
        <span class="love-item accent">Dark Themes</span>
        <span class="love-item">·</span>
        <span class="love-item">Smooth Animations</span>
        <span class="love-item">·</span>
        <span class="love-item accent">Tea</span>
        <span class="love-item">·</span>
        <span class="love-item">Fast Builds</span>
        <span class="love-item">·</span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <!-- ── Certifications ── -->
  <div class="section">
    <div class="section-label reveal">Credentials</div>
    <h2 class="section-title reveal">Certifications.</h2>

    <div class="certs-list reveal-stagger">
      <div class="cert-row">
        <span class="cert-num">01</span>
        <div class="cert-info">
          <div class="cert-name">PWPA Practical Web Pentest Associate</div>
          <div class="cert-issuer">TCM-Security</div>
        </div>
        <span class="cert-year">2026</span>
        <span class="cert-badge">Active</span>
      </div>
      <!-- add more certs here -->
    </div>
  </div>

  <div class="divider"></div>

  <!-- ── Projects (top 3 featured, full list lives on /projects/) ── -->
  <div class="section">
    <div class="section-label reveal">Work</div>
    <h2 class="section-title reveal">Projects.</h2>

    <div class="projects-grid reveal-stagger">
      {% for project in collections.projects | limit(3) %}
      <a href="{{ project.data.link or project.url }}" class="project-card p{{ loop.index }}" {% if project.data.link %}target="_blank"{% endif %}>
        <div class="project-thumb">
          <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
            <circle cx="30" cy="30" r="20" stroke="rgba(91,94,255,0.4)" stroke-width="1.5"/>
            <circle cx="30" cy="30" r="10" stroke="rgba(91,94,255,0.6)" stroke-width="1.5"/>
            <circle cx="30" cy="30" r="3" fill="rgba(91,94,255,0.9)"/>
          </svg>
        </div>
        <div class="project-body">
          <div class="project-tags">
            {% for tag in project.data.tags %}<span class="project-tag">{{ tag }}</span>{% endfor %}
          </div>
          <div class="project-name">{{ project.data.title }}</div>
          <p class="project-desc">{{ project.data.summary }}</p>
          <div class="project-link">
            View Project
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>

{% endblock %}

